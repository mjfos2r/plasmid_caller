# Web portal image. Build from the repository root:
#   docker build -f Dockerfile.web --build-arg SOURCE_REVISION=$(git rev-parse HEAD) -t <image> .
ARG BASE_IMAGE=python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
ARG SOURCE_REVISION=unknown
ARG SEQKIT_VERSION=v2.10.0

COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /bin/uv

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates libgomp1 xxd \
    && rm -rf /var/lib/apt/lists/*

RUN base=https://github.com/shenwei356/seqkit/releases/download/${SEQKIT_VERSION}/seqkit_linux_amd64.tar.gz \
    && curl -fLsS "$base" -o /tmp/seqkit.tar.gz \
    && [ "$(md5sum /tmp/seqkit.tar.gz | cut -d' ' -f1)" = "$(curl -fLsS "$base.md5.txt" | cut -d' ' -f1)" ] \
    && tar -xzf /tmp/seqkit.tar.gz -C /usr/local/bin --no-same-owner \
    && rm /tmp/seqkit.tar.gz

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --extra web --no-editable
ENV PATH="/app/.venv/bin:$PATH"

# Fetches the BLAST binaries into the package while this layer can still write there.
RUN plasmid_caller --version

RUN useradd --system --uid 10001 portal && mkdir -p /data/runs && chown -R portal /data
ENV BASE_IMAGE=${BASE_IMAGE} SOURCE_REVISION=${SOURCE_REVISION}
USER portal
WORKDIR /data
EXPOSE 8080

# One job at a time: each one needs about 500 MB of scratch, which counts as memory on Cloud Run.
CMD ["sh", "-c", "exec plasmid_caller serve --host 0.0.0.0 --port ${PORT:-8080} --runs-dir ${RUNS_DIR:-/data/runs} --jobs 1 --threads ${BLAST_THREADS:-2} --max-upload-mb 20 --max-assembly-mb 50 --max-queued 20 --job-timeout 900"]
